{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite@8.2.2",
    "build": "deno run -A npm:vite@8.2.2 build",
    "preview": "deno run -A npm:vite@8.2.2 preview",
    "desktop": "deno task build && deno desktop --icon public/icon.png -A --hmr desktop.ts",
    "desktop:build": "deno task build && deno desktop --icon public/icon.png -A desktop.ts",
    "desktop:app": "deno task build && deno desktop --icon public/icon.png -A -o Skillet.app desktop.ts",
    "lint": "deno run -A npm:oxlint@1.80.0",
    "test": "deno test -A",
    "check": "deno check src/main.tsx src/App.tsx tests/*_test.ts"
  },
  "imports": {
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.5",
    "oxlint": "npm:oxlint@1.80.0",
    "oxc-transform-react": "npm:oxc-transform-react@0.144.0",
    "@oxlint/plugins": "npm:@oxlint/plugins@1.80.0",
    "react": "npm:react@19.2.8",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "@phosphor-icons/react": "npm:@phosphor-icons/react@2.1.10",

    "@stylexjs/stylex": "npm:@stylexjs/stylex@0.19.0",
    "@stylexjs/unplugin": "npm:@stylexjs/unplugin@0.19.0",
    "comark": "npm:comark@0.6.2",
    "@comark/react": "npm:@comark/react@0.6.2",
    "shiki": "npm:shiki@4.3.1",
    "yaml": "npm:yaml@2.7.0",

    "react-resizable-panels": "npm:react-resizable-panels@2.1.7"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19.2.18",
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  }
}
