{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite@8.2.2",
    "build": "deno run -A npm:vite@8.2.2 build",
    "preview": "deno run -A npm:vite@8.2.2 preview",
    "desktop": "deno desktop --hmr desktop.ts",
    "desktop:build": "deno desktop desktop.ts",
    "lint": "deno run -A npm:oxlint@1.80.0",
    "test": "deno test -A"
  },
  "imports": {
    "oxlint": "npm:oxlint@1.80.0",
    "@oxlint/plugins": "npm:@oxlint/plugins@1.80.0",
    "react": "npm:react@19.0.0",
    "react/": "npm:react@19.0.0/",
    "react-dom": "npm:react-dom@19.0.0",
    "react-dom/": "npm:react-dom@19.0.0/",
    "react-dom/client": "npm:react-dom@19.0.0/client",
    "@phosphor-icons/react": "npm:@phosphor-icons/react@2.1.10",
    "clsx": "npm:clsx@2.1.1",
    "tailwind-merge": "npm:tailwind-merge@3.0.1",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "comark": "npm:comark@0.6.2",
    "@comark/react": "npm:@comark/react@0.6.2",
    "yaml": "npm:yaml@2.7.0",
    "class-variance-authority": "npm:class-variance-authority@0.7.1",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@1.3.3",
    "@radix-ui/react-switch": "npm:@radix-ui/react-switch@1.3.7",
    "@radix-ui/react-select": "npm:@radix-ui/react-select@2.3.7",
    "@radix-ui/react-scroll-area": "npm:@radix-ui/react-scroll-area@1.2.18",
    "@radix-ui/react-separator": "npm:@radix-ui/react-separator@1.1.15"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  }
}
