{
  "$schema": "./node_modules/@legendapp/spark/desktop.config.schema.json",
  "name": "Skillet",
  "projectId": "skillet-macos-desktop",
  "version": "2.0.0",
  "platforms": ["macos"],
  "macos": {
    "bundleIdentifier": "so.skillet.macos"
  },
  "window": {
    "title": "Skillet",
    "size": {
      "width": 1240,
      "height": 820
    },
    "minSize": {
      "width": 960,
      "height": 640
    },
    "titleBarStyle": "overlay",
    "restoreBounds": true,
    "macos": {
      "backgroundMaterial": "windowBackground",
      "titleBar": {
        "trafficLights": true
      }
    }
  },
  "expo": {
    "icon": "./assets/icon.png",
    "autolinking": {
      "exclude": ["react-native-windows"]
    }
  }
}
